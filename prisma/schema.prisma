generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Bundle {
  id        String   @id
  createdAt DateTime @default(now())

  // Optional future use
  name      String?
  isDeleted Boolean  @default(false)

  files      File[]
  shareLinks ShareLink[]
}

model File {
  id           String   @id @default(uuid())
  originalName String
  mimeType     String
  size         Int

  storageKey String?   // null until upload completes
  status     FileStatus

  bundleId String
  bundle   Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  isDeleted Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShareLink {
  id        String   @id @default(uuid())
  bundleId  String
  token     String   @unique

  expiresAt     DateTime?
  password      String?
  downloadCount Int      @default(0)
  maxDownloads  Int?
  isActive      Boolean  @default(true)

  createdAt DateTime @default(now())

  bundle Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@index([bundleId])
  @@index([expiresAt])
}

enum FileStatus {
  PENDING
  UPLOADING
  COMPLETED
  FAILED
}